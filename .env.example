# Configuración del validation service. Copiar a .env y ajustar según el entorno.

# Tamaño máximo de PDF aceptado, en bytes (default: 10485760 = 10 MB).
MAX_PDF_SIZE_BYTES=10485760

# Orígenes CORS permitidos, separados por coma (default: http://localhost).
# No usar "*" junto con credenciales.
CORS_ORIGINS=http://localhost

# Nivel de logging: DEBUG, INFO, WARNING o ERROR (default: INFO).
LOG_LEVEL=INFO

# Puerto en que escucha uvicorn (default: 8000).
PORT=8000
